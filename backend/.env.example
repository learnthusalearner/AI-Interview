# ─────────────────────────────────────────────────────────────────
#  AI Interview — Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production | test
CORS_ORIGIN="*"               # Set to your frontend URL in production, e.g. https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ── AI — OpenAI ───────────────────────────────────────────────────
# Required. Used for Whisper STT (whisper-1) and chat/evaluation (gpt-4o-mini).
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."

# ── AI — Google Gemini (Optional) ────────────────────────────────
# When set, Gemini acts as the PRIMARY LLM; OpenAI is the fallback.
# Get yours free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ── Email — SMTP (Optional) ───────────────────────────────────────
# Required only if you want automated acceptance/rejection emails sent to candidates.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="\"Careers\" <careers@example.com>"
